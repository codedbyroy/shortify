{
  "name": "brief-url-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check": "tsc --noEmit",
    "test": "vitest run && node --test test/countdown.node.mjs",
    "build": "wrangler deploy --dry-run --outdir dist && wrangler pages functions build --cwd pages --outdir ../dist/pages",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.3",
    "@cloudflare/workers-types": "5.20261117.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "4.163.0"
  }
}
